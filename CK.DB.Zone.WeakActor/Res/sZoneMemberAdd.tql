-- SetupConfig: {}
create transformer on CK.sZoneMemberAdd
as
begin

    /*
        The injections don't rely on the content of <PreZoneMemberAdd>: other transformers (CK.DB.HZone)
        inject into it and their order relative to this one is not defined.
        - The @DefiningParentZoneId is declared before <PreZoneMemberAdd>: the injected code can use (and
          change) it, see CK.DB.HZone.WeakActor.
        - The check is done after <PreZoneMemberAdd>, right before the insertion.
    */

    inject "
        -- For a WeakActor, @DefiningParentZoneId is not null.
        declare @DefiningParentZoneId int;
        select @DefiningParentZoneId = w.ZoneId from CK.tWeakActor w where w.WeakActorId = @MemberId;
    "
    before single "--<PreZoneMemberAdd";

    inject "
            -- If the @MemberId is a WeakActor it SHOULD already be in the Zone:
            -- if it's not, let this call fix it (but only for the defining Zone).
            if @DefiningParentZoneId is not null and @DefiningParentZoneId <> @ZoneId
            begin
		        ;throw 50000, 'Group.InvalidWeakActorZone', 1;
            end
    "
    before single {insert into CK.tActorProfile( ActorId, GroupId ) values( @MemberId, @ZoneId );};

end
