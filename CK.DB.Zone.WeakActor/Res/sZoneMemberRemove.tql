-- SetupConfig: {}
create transformer on CK.sZoneMemberRemove
as
begin

inject "
        -- A WeakActor cannot be removed from its defining Zone.
        if exists(select 1 from CK.tWeakActor w where w.WeakActorId = @MemberId and w.ZoneId = @ZoneId)
        begin
            ;throw 50000,'Zone.CannotRemoveWeakActor',1;
        end
"
into PreZoneMemberRemove

end
