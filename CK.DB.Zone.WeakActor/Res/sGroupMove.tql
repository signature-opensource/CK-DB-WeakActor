-- SetupConfig: {}
create transformer on CK.sGroupMove
as
begin
    -- When a Group is moved to another Zone, any WeakActor (that necessarily belongs to the initial Zone) are automatically
    -- removed (this uses the "Intersect" option).

    replace single {;throw 50000, 'Group.MemberNotInZone', 1;}
        with "
            -- Edge case: the Group contains ONLY weak actors: the Group is cleared (Intersect is the default for Weak Actors).
            if exists( select p.ActorId from CK.tActorProfile p where p.GroupId = @GroupId and p.ActorId <> p.GroupId
							except 
					    select w.WeakActorId from CK.tWeakActor w where w.ZoneId = @CurrentZoneId )
            begin
				;throw 50000, 'Group.MemberNotInZone', 1;
            end
            else
            begin
                exec CK.sGroupRemoveAllMembers @ActorId, @GroupId;
            end
		";

    inject "
                       or exists(select 1 from CK.tWeakActor where WeakActorId = @ExtraMemberIdInZone) -- WeakActors don't follow the group.
					"
    after last out of 2 {if @Option = 1};

end
