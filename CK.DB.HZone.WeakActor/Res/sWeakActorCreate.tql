-- SetupConfig: {}
create transformer on CK.sWeakActorCreate
as
begin

    inject
    "
        -- The name must not exist in the @ZoneId, in one of its parents or in one of its children.
        -- This uses the hierarchyid directly (instead of the CK.vZoneAllChildren view that is a full
        -- tZone x tZone join): only the WeakActors with the same name are considered.
        declare @ZoneHId hierarchyid = (select HierarchicalId from CK.tZone where ZoneId = @ZoneId);
        if exists( select 1
                    from CK.tWeakActor n
                    inner join CK.tZone zn on zn.ZoneId = n.ZoneId
                    where n.WeakActorName = @WeakActorName
                      and (zn.HierarchicalId.IsDescendantOf( @ZoneHId ) = 1 or @ZoneHId.IsDescendantOf( zn.HierarchicalId ) = 1) )
        begin
            ;throw 50000, 'WeakActor.WeakActorNameShouldBeUniqueInHZone', 1;
        end
    "
    into PreCreate

end
