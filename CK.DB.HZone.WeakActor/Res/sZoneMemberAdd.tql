-- SetupConfig: {}
create transformer on CK.sZoneMemberAdd
as
begin

    inject
    "
        -- A WeakActor is never a member of the Zones above its defining Zone: only the @Parents from
        -- its defining Zone must be considered (regardless of @AutoAddMemberInParentZone).
        -- The root Zone 0 (level 0) is the parent of all the Zones: all the @Parents are considered.
        -- When the defining Zone doesn't appear in the @Parents, no parent is considered: this fails
        -- below with Group.InvalidWeakActorZone (unless this Zone is the defining Zone).
        if @DefiningParentZoneId is not null
        begin
            declare @DefiningParentDepth int = -1;
            if @DefiningParentZoneId = 0 set @DefiningParentDepth = 0;
            else select @DefiningParentDepth = p.Depth from @Parents p where p.ZoneId = @DefiningParentZoneId;
            delete from @Parents where @DefiningParentDepth < 0 or Depth < @DefiningParentDepth;
            if @DefiningParentDepth >= 0
            begin
                -- The defining Zone is a parent: the Zone can accept the WeakActor.
                set @DefiningParentZoneId = null;
            end
        end
    "
    after single {order by z.HierarchicalId.GetLevel() asc;};

end
